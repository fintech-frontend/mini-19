# Nusxa oling: .env.local (mahalliy) yoki hosting sozlamalari (Vercel → Settings → Environment Variables).
# .env* fayllar git'ga tushmaydi (.gitignore), faqat shu namuna.

# ─── Do'kon backendi (sayt va admin panel bitta API) ─────────────────────────
NEXT_PUBLIC_API_URL=http://16.170.163.62/api
# Formalar (ixtiyoriy): kontakt formasi va obuna yo'llari
NEXT_PUBLIC_CONSULT_ENDPOINT=
NEXT_PUBLIC_SUBSCRIBE_ENDPOINT=

# ─── Admin panel (/admin) — faqat serverda, brauzerga chiqmaydi ──────────────
# Serverda tekshiriladigan akkauntlar: "login:parol:ROL" vergul bilan.
# Rollar: SUPER_ADMIN, MANAGER, WAREHOUSE, ACCOUNTANT, CONTENT
# Bo'sh bo'lsa panel demo rejimida (faqat `next dev` da, NEXT_PUBLIC_ADMIN_DEMO_* bilan).
ADMIN_USERS=superadmin
# Sessiya cookie imzosi, kamida 32 belgi (masalan: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# ─── Fintechhub-payment Merchant API (hujjat: http://159.223.145.49:3078) ────
FHP_API_URL=http://159.223.145.49:3077/api/v2
# Merchant kabinetidagi /api/auth/me/ javobidan
FHP_MERCHANT_USER_ID=
FHP_MERCHANT_SECRET_KEY=
# Servisning BAZA ID si (services ro'yxatidagi "id", public "service_id" kodi emas)
FHP_SERVICE_ID=

# ─── Admin demo rejimi (faqat `next dev`, server sozlanmagan bo'lsa) ─────────
# NEXT_PUBLIC_ bilan boshlanganlar brauzerga chiqadi — kalit qo'ymang.
NEXT_PUBLIC_ADMIN_DEMO_LOGIN=
NEXT_PUBLIC_ADMIN_DEMO_PASSWORD=
# Xodim ro'yxatdan o'tganda (mock) SMS shu raqamga "yuboriladi"
NEXT_PUBLIC_ADMIN_SUPER_PHONE=+998900000000
